# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) o, en proyectos antiguos, la "anon public key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública de la web (para SEO, sitemap y enlaces de recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=https://www.aislaser.es
